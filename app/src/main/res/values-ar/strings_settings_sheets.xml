    <!-- ===== Settings: sync ===== -->
    <string name="settings_sync_title">المزامنة بين الهواتف</string>
    <string name="settings_sync_summary_status">مفعّلة · %1$s</string>
    <string name="settings_sync_note">لا يوجد خادم لـ Plait. يمكن اختيار مجلد يزامنه بين الهواتف تطبيق سحابي مستخدَم بالفعل، مثل Google Drive أو Dropbox أو Nextcloud أو Syncthing. ولا يضع Plait فيه إلا ملفات مشفّرة.</string>
