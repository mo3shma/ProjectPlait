<?xml version="1.0" encoding="utf-8"?>
<!-- AR One Sans is one variable file; pin the weights the widget asks for (textStyle bold picks 700). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/ar_one_sans" android:fontWeight="400" android:fontStyle="normal" android:fontVariationSettings="'wght' 400" />
    <font android:font="@font/ar_one_sans" android:fontWeight="600" android:fontStyle="normal" android:fontVariationSettings="'wght' 600" />
    <font android:font="@font/ar_one_sans" android:fontWeight="700" android:fontStyle="normal" android:fontVariationSettings="'wght' 700" />
</font-family>
