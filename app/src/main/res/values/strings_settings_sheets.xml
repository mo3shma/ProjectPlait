    <string name="sheet_tour_1_title">Every calendar, one day</string>
    <string name="sheet_tour_1_text">Google, Outlook, Exchange, iCloud and calendar links in one agenda. Switch any account or calendar off when you like.</string>
    <string name="sheet_tour_2_title">A card for each part of the day</string>
    <string name="sheet_tour_2_text">Morning shows what\'s ahead, Midday what\'s done and what\'s left, Evening how the day went and what still needs notes. Swipe between them.</string>
    <string name="sheet_tour_3_title">Everything about a meeting</string>
    <string name="sheet_tour_3_text">Who\'s coming and their answers, what it\'s about, one tap to Join, and a button to edit, reschedule or answer the invite.</string>
    <string name="sheet_tour_4_title">Notes four ways</string>
    <string name="sheet_tour_4_text">Voice notes written as you speak, written notes, photos read into text, and checklists. Plait suggests tasks from them and reminds you.</string>
    <string name="sheet_tour_5_title">AI that stays on your phone</string>
    <!-- The arrow points the way you read: Settings, then "AI on this phone". -->
    <string name="sheet_tour_5_text">Pick a model in Settings → AI on this phone. Summaries, prep and search run on the phone. Nothing is sent to a server, and there\'s no account.</string>
    <string name="sheet_tour_6_title">Let\'s bring your day in</string>
    <string name="sheet_tour_6_text">Plait reads the calendars already on this phone. You can add more, or calendar links, in Settings later.</string>

