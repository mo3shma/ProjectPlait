<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg_morning"
    android:orientation="vertical" android:padding="18dp" >
    <TextView android:id="@+id/widget_greeting"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#B30E1316" android:textSize="12sp"
        android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" />
    <TextView android:id="@+id/widget_headline"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FF0E1316" android:textSize="24sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_summary"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#CC0E1316" android:textSize="13sp"
        android:maxLines="2" android:ellipsize="end" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="10dp" />
    <LinearLayout android:id="@+id/widget_next"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/widget_row_bg" android:orientation="vertical"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="10dp">
    <TextView android:id="@+id/widget_next_label"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#B30E1316" android:textSize="11sp"
        android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" />
    <TextView android:id="@+id/widget_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FF0E1316" android:textSize="17sp" android:textStyle="bold"
        android:maxLines="2" android:ellipsize="end" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/widget_when" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="#CC0E1316" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
                <Chronometer android:id="@+id/widget_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#FF0E1316" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
            </LinearLayout>
            <TextView android:id="@+id/widget_join" android:layout_width="wrap_content" android:layout_height="36dp"
                android:background="@drawable/widget_pill" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:text="Join" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_row1"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:background="@drawable/widget_row_bg" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="9dp" android:paddingBottom="9dp">
        <TextView android:id="@+id/widget_row1_time"
            android:layout_width="72dp" android:layout_height="wrap_content"
            android:textColor="#CC0E1316" android:textSize="12sp" android:maxLines="1" />
        <TextView android:id="@+id/widget_row1_title"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#FF0E1316" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_row2"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:background="@drawable/widget_row_bg" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="9dp" android:paddingBottom="9dp">
        <TextView android:id="@+id/widget_row2_time"
            android:layout_width="72dp" android:layout_height="wrap_content"
            android:textColor="#CC0E1316" android:textSize="12sp" android:maxLines="1" />
        <TextView android:id="@+id/widget_row2_title"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#FF0E1316" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_row3"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:background="@drawable/widget_row_bg" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="9dp" android:paddingBottom="9dp">
        <TextView android:id="@+id/widget_row3_time"
            android:layout_width="72dp" android:layout_height="wrap_content"
            android:textColor="#CC0E1316" android:textSize="12sp" android:maxLines="1" />
        <TextView android:id="@+id/widget_row3_title"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#FF0E1316" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_row4"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:background="@drawable/widget_row_bg" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="9dp" android:paddingBottom="9dp">
        <TextView android:id="@+id/widget_row4_time"
            android:layout_width="72dp" android:layout_height="wrap_content"
            android:textColor="#CC0E1316" android:textSize="12sp" android:maxLines="1" />
        <TextView android:id="@+id/widget_row4_title"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#FF0E1316" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_row5"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:background="@drawable/widget_row_bg" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="9dp" android:paddingBottom="9dp">
        <TextView android:id="@+id/widget_row5_time"
            android:layout_width="72dp" android:layout_height="wrap_content"
            android:textColor="#CC0E1316" android:textSize="12sp" android:maxLines="1" />
        <TextView android:id="@+id/widget_row5_title"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#FF0E1316" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
