<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg_soft"
    android:orientation="vertical"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_date" android:text="@string/widget_tasks_title"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textAlignment="viewStart" android:textColor="@color/widget_ink" android:textSize="14sp" android:textFontWeight="600"
            android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFamily="@font/widget_font" />
        <TextView android:id="@+id/widget_count" android:text="3"
            android:layout_width="wrap_content" android:layout_height="20dp" android:layout_marginStart="6dp"
            android:background="@drawable/widget_capsule" android:gravity="center"
            android:paddingStart="8dp" android:paddingEnd="8dp"
            android:textColor="@color/widget_ink" android:textSize="12sp" android:textFontWeight="600"
            android:includeFontPadding="false" android:maxLines="1" android:fontFamily="@font/widget_font" />
        <TextView android:id="@+id/widget_add" android:text="+"
            android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="-10dp" android:layout_marginTop="-6dp" android:layout_marginBottom="-6dp"
            android:contentDescription="@string/widget_tile_task_list" android:gravity="center"
            android:textColor="@color/widget_ink" android:textSize="22sp" android:textFontWeight="600"
            android:includeFontPadding="false" android:fontFamily="@font/widget_font" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_list"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/widget_task_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:textAlignment="viewStart" android:textColor="@color/widget_ink" android:textSize="13sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFamily="@font/widget_font" android:text="@string/widget_tasks_empty" />
        <TextView android:id="@+id/widget_task_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:textAlignment="viewStart" android:textColor="@color/widget_ink" android:textSize="13sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFamily="@font/widget_font" />
        <TextView android:id="@+id/widget_task_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:textAlignment="viewStart" android:textColor="@color/widget_ink" android:textSize="13sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFamily="@font/widget_font" />
        <TextView android:id="@+id/widget_task_4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:textAlignment="viewStart" android:textColor="@color/widget_ink" android:textSize="13sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFamily="@font/widget_font" />
        <TextView android:id="@+id/widget_task_5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:textAlignment="viewStart" android:textColor="@color/widget_ink" android:textSize="13sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFamily="@font/widget_font" />
    </LinearLayout>
</LinearLayout>
