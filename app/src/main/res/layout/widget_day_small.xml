<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/widget_date" android:text="Wed 21"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textAlignment="viewStart" android:textColor="#BFFFFFFF" android:textSize="11sp"
            android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/widget_top_end" android:text="+2 more"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp"
            android:textColor="#BFFFFFFF" android:textSize="11sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_next"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="2dp" android:orientation="vertical">
        <TextView android:id="@+id/widget_title" android:text="Design review"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAlignment="viewStart" android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold"
            android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widget_when" android:text="10:30 AM"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:textAlignment="viewStart" android:textColor="#BFFFFFFF" android:textSize="14sp"
            android:fontFeatureSettings="tnum" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/widget_join"
        android:layout_width="match_parent" android:layout_height="32dp"
        android:background="@drawable/widget_pill" android:gravity="center"
        android:text="Join" android:textColor="#FF141820" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_footer" android:text="+2 more today"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAlignment="viewStart" android:textColor="#BFFFFFFF" android:textSize="12sp"
        android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
