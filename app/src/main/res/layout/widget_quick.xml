<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg_midday"
    android:orientation="vertical"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">
    <LinearLayout android:id="@+id/widget_next"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:background="@drawable/widget_capsule" android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="14dp" android:paddingEnd="10dp">
        <ImageView android:id="@+id/widget_dot" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="8dp"
            android:src="@drawable/widget_dot" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:id="@+id/widget_time" android:text="1:30 PM"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAlignment="viewStart" android:textColor="#E6FFFFFF" android:textSize="12sp" android:textFontWeight="600"
                android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFamily="@font/widget_font" />
            <TextView android:id="@+id/widget_title" android:text="Design review"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAlignment="viewStart" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold"
                android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFamily="@font/widget_font" />
        </LinearLayout>
        <TextView android:id="@+id/widget_join"
            android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="8dp"
            android:background="@drawable/widget_pill_other" android:gravity="center"
            android:drawableStart="@drawable/ic_widget_video" android:drawablePadding="5dp"
            android:paddingStart="12dp" android:paddingEnd="14dp"
            android:text="Join" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textFontWeight="600"
            android:includeFontPadding="false" android:fontFamily="@font/widget_font" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="88dp" android:layout_marginTop="8dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/widget_tile_voice"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/widget_tile_voice" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/widget_icon_circle"
                android:padding="7dp" android:src="@drawable/ic_widget_mic" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="Voice note" android:textColor="#FF0E1316" android:textSize="13sp" android:textFontWeight="600"
                android:includeFontPadding="false" android:maxLines="1" android:fontFamily="@font/widget_font" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_tile_list"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp"
            android:background="@drawable/widget_tile_list" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/widget_icon_circle"
                android:padding="7dp" android:src="@drawable/ic_widget_checklist" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="Task list" android:textColor="#FF0E1316" android:textSize="13sp" android:textFontWeight="600"
                android:includeFontPadding="false" android:maxLines="1" android:fontFamily="@font/widget_font" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_tile_text"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp"
            android:background="@drawable/widget_tile_text" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/widget_icon_circle"
                android:padding="7dp" android:src="@drawable/ic_widget_pencil" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="Text note" android:textColor="#FF0E1316" android:textSize="13sp" android:textFontWeight="600"
                android:includeFontPadding="false" android:maxLines="1" android:fontFamily="@font/widget_font" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
